{
  "name": "el-mezaen-talakh-booking",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/clean-dist.mjs && node scripts/generate-seo.mjs && vite build",
    "verify:build": "node scripts/verify-build.mjs",
    "audit:links": "node scripts/link-audit.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "audit:performance": "node scripts/performance-audit.mjs",
    "verify:firebase": "node scripts/verify-firebase.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:functions": "npm --prefix functions test",
    "test:rules": "npx firebase-tools emulators:exec --project demo-el-mezaen-rules --only firestore,storage \"node --test tests/firebase-rules.emulator.mjs\"",
    "test:gate:handlers": "npx firebase-tools emulators:exec --project demo-el-mezaen-gate --only auth,firestore \"node --test tests/v6-1-production-gate.emulator.mjs\"",
    "migration:catalog:dry": "npm --prefix functions run migration:catalog:dry",
    "migration:catalog:apply": "npm --prefix functions run migration:catalog:apply --",
    "verify:assets": "python3 scripts/verify-premium-assets.py",
    "package:release": "python3 scripts/package-release.py"
  },
  "dependencies": {
    "@fontsource/alexandria": "^5.2.8",
    "@fontsource/tajawal": "^5.2.7",
    "@zxing/browser": "^0.1.5",
    "firebase": "12.19.0",
    "jsbarcode": "^3.12.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "vite": "^7.0.6"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.5"
    }
  }
}

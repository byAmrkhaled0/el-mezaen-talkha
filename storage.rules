rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function canManageMedia() {
      return request.auth != null && (request.auth.token.role == 'admin' || (request.auth.token.role == 'manager' && request.auth.token.permissions is list && request.auth.token.permissions.hasAny(['gallery', 'results', 'hairMedia', 'celebrities', 'posts', 'settings'])));
    }
    function isValidMedia() {
      return (
        (request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/(jpeg|png|webp|avif)'))
        ||
        (request.resource.size < 30 * 1024 * 1024
          && request.resource.contentType.matches('video/(mp4|webm)'))
      );
    }
    function isOwnWorkerPhoto(staffId) {
      return request.auth != null
        && request.auth.token.role == 'worker'
        && request.auth.token.staffId == staffId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
    }
    match /public/staff/{staffId}/{fileName} {
      allow read: if true;
      allow create, update: if canManageMedia() || isOwnWorkerPhoto(staffId);
      allow delete: if canManageMedia();
    }
    match /public/{allPaths=**} {
      allow read: if true;
      allow create, update: if canManageMedia() && isValidMedia();
      allow delete: if canManageMedia();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
